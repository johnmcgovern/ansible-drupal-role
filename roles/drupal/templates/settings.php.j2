<?php

// {{ ansible_managed }}
// Managed by Ansible. Local edits will be overwritten on the next playbook run.

$databases = [];
$settings['update_free_access'] = FALSE;

// Read the salt from a file outside the docroot that is generated once on the
// host. Keeping it out of this template means re-running Ansible cannot
// invalidate the sessions and one-time login links of a running site.
$settings['hash_salt'] = trim(file_get_contents('{{ drupal_hash_salt_file }}'));

$settings['file_scan_ignore_directories'] = [
  'node_modules',
  'bower_components',
];

$settings['entity_update_batch_size'] = 50;

// Drupal 12 will default this to FALSE. Leaving it unset raises a warning on
// the status report; setting it explicitly both silences that and pins the
// behaviour so a major upgrade cannot change form validation underneath you.
// https://www.drupal.org/node/3537128
$settings['enable_html5_validation'] = {{ 'TRUE' if drupal_enable_html5_validation else 'FALSE' }};

$settings['config_sync_directory'] = '{{ drupal_config_sync_relative }}';

// Core's default.settings.php registers this; without it Drupal never reads
// sites/default/services.yml and any service or parameter override there is
// silently ignored.
$settings['container_yamls'][] = $app_root . '/' . $site_path . '/services.yml';

$databases['default']['default'] = [
  'database' => '{{ db_name }}',
  'username' => '{{ db_user }}',
  'password' => '{{ db_user_password }}',
  'prefix' => '',
  'host' => '{{ db_host }}',
  'port' => '{{ db_port }}',
  'driver' => 'mysql',
  'namespace' => 'Drupal\\mysql\\Driver\\Database\\mysql',
  'autoload' => 'core/modules/mysql/src/Driver/Database/mysql/',
];

{% if drupal_trusted_host_patterns | default([]) | length > 0 %}
$settings['trusted_host_patterns'] = [
{% for pattern in drupal_trusted_host_patterns %}
  '{{ pattern }}',
{% endfor %}
];
{% else %}
// Host header protection is disabled because drupal_trusted_host_patterns is
// empty. Set it in group_vars to enable -- see README.
{% endif %}
