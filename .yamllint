---
extends: default

rules:
  line-length:
    max: 200
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  # Required by ansible-lint: file modes must be quoted strings ("0644"), never
  # bare 0644 (parsed as octal) or 644 (parsed as decimal 644, not mode 0644).
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .git/
