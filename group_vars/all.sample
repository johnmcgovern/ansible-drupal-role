---
#
# Copy to group_vars/all and edit. Anything marked SECRET below should live in
# an ansible-vault encrypted file rather than here in plaintext -- see README.
#

#
# Ansible connection
#

ansible_user: username

# Only needed when the key is not one SSH would find on its own (no ~/.ssh/config
# entry and not a default filename such as ~/.ssh/id_ed25519).
# ansible_ssh_private_key_file: ~/.ssh/id_ed25519


#
# Web server
#

webserver_sitename: mysite.example.com
webserver_email: example@example.com

webserver_max_body_size: 64M

# TLS via Let's Encrypt. Requires webserver_sitename to be a public hostname
# that resolves to this server, with port 80 reachable from the internet for
# the ACME HTTP-01 challenge. Enabling this redirects all HTTP to HTTPS.
#
# Debian-family hosts only. RHEL ships no certbot outside EPEL, so enabling this
# on a Red Hat host fails with an explanation rather than deploying an untested
# path -- terminate TLS in front of the host instead.
webserver_tls_enabled: false

# Address Let's Encrypt registers and sends expiry notices to. Defaults to
# webserver_email, so set it only if they should differ.
# webserver_tls_email: certs@example.com

# http-01 (default) serves a challenge file over port 80 and needs the host to
# be reachable from the internet. dns-01 writes a TXT record through the
# Cloudflare API instead, which is what an internal or firewalled host needs --
# the server itself never has to accept inbound connections.
webserver_tls_challenge: http-01

# Required for dns-01. A Cloudflare API token scoped to Zone:DNS:Edit on this
# zone. SECRET -- put it in an ansible-vault encrypted file, not here.
# webserver_tls_cloudflare_token: "{{ vault_cloudflare_token }}"

# Set true while testing. Issues an untrusted certificate from the Let's
# Encrypt staging CA, which has far looser rate limits than production
# (production allows only 5 duplicate certificates per week).
webserver_tls_staging: false

# The account the web server runs as. Left unset on purpose: the default is
# derived from the distribution, because the nginx package creates a different
# account on each -- www-data on Ubuntu, nginx on RHEL -- and a value hardcoded
# here would be wrong on one of them. Setting it to www-data on a RHEL host
# gives a site that installs cleanly and then cannot write a single cache entry.
#
# Override only if you run nginx as something other than the account its own
# package created.
# webserver_user: www-data
# webserver_group: www-data


#
# PHP tuning
#
# Written as a conf.d drop-in; the packaged php.ini is never edited. See
# roles/web/defaults/main.yml for the full set of knobs and their defaults.
#

php_memory_limit: 256M
php_max_execution_time: 60

# These default to webserver_max_body_size so the PHP and web server limits
# cannot drift apart. Override only if you need them to differ.
# php_upload_max_filesize: 64M
# php_post_max_size: 64M

php_opcache_memory_consumption: 192
php_apcu_shm_size: 64M

# AVIF support in GD -- OPT IN, DISABLED BY DEFAULT, UBUNTU ONLY.
#
# Not available on RHEL, which ships no libavif in BaseOS or AppStream and so
# has nothing for the build below to link against. Enabling it there fails with
# that explanation; the GD warning on the status report is permanent instead.
#
# Ubuntu ships libgd2 without libavif deliberately (LP#2031934) and will not fix
# it for a released version -- true of 24.04 and 26.04 alike -- so Drupal 11.2+
# reports a GD status page warning that cannot be cleared with distribution
# packages. Setting this true compiles a private libgd and PHP gd extension
# under /opt/gd-avif and points PHP at them. The system libgd3 is left alone and
# stays managed by apt.
#
# WARNING -- what you take on by enabling it:
#   * libgd and libavif security updates no longer reach the copy PHP loads.
#     apt will keep patching the system libgd3; it will not touch this build.
#   * A PHP upgrade that changes the extension ABI requires a rebuild. The
#     build stamp detects it, but the site runs without GD in the meantime.
#   * ~250 MB of build tooling is installed on the target and stays there.
#   * Ubuntu does not support this configuration.
#
# MITIGATION: both risks are bounded by how often this playbook runs, because
# the rebuild only happens on a run. Schedule one (a systemd timer or cron entry
# invoking ansible-pull, or whatever drives your deploys) so an ABI change is
# picked up in hours rather than whenever someone next deploys by hand, and so
# you find out promptly when a rebuild is due. Watch libgd and libavif
# advisories yourself; apt will not tell you.
#
# If you only need AVIF derivatives and not a clean status page, php-imagick
# with the ImageMagick toolkit module is the supported alternative.
php_gd_avif_build: false

# pm.max_children caps concurrent PHP requests. Budget roughly
# max_children * php_memory_limit as the worst case, and lower it on a small VM.
php_fpm_pool_settings:
  pm: dynamic
  pm.max_children: 20
  pm.start_servers: 4
  pm.min_spare_servers: 2
  pm.max_spare_servers: 6
  pm.max_requests: 500


#
# MariaDB
#
# The MariaDB root account authenticates via the unix_socket plugin, so there
# is no db_root_password. Administrative tasks connect over the local socket as
# system root, which is stronger than storing a root password here.
#

db_service: mariadb
db_host: localhost
db_port: 3306

# Drupal recommends READ-COMMITTED; MariaDB defaults to REPEATABLE-READ, which
# the Drupal status report flags as a warning.
db_transaction_isolation: READ-COMMITTED

db_name: drupal
db_user: drupal_user
db_user_password: CHANGEME   # SECRET
db_user_perms: "SELECT,INSERT,UPDATE,DELETE,CREATE,DROP,INDEX,ALTER,CREATE TEMPORARY TABLES,LOCK TABLES"


#
# Drupal
#

drupal_base_path: /var/www/drupal

# Drupal release to install. Empty installs the newest stable. Pin to an exact
# version ("11.4.4") to build on a known release. Only affects a first install;
# use upgrade.yml to move an installed site forward.
drupal_version: ""

drupal_sitename: Drupal Test Site
drupal_email: example@example.com
drupal_region: en

# Cron. A systemd timer runs drush cron on this schedule and Drupal's
# request-triggered automated_cron module is disabled. Any systemd OnCalendar
# expression works; use "*:0/15" for every fifteen minutes on a busy site.
drupal_cron_enabled: true
drupal_cron_on_calendar: hourly

# Backups. A systemd timer dumps the database (via MariaDB socket auth, so no
# password is stored) and archives the files directory into a root-only
# directory. Restore with /usr/local/sbin/drupal-restore.sh --list.
drupal_backup_enabled: true
drupal_backup_path: /var/backups/drupal
drupal_backup_on_calendar: daily
drupal_backup_retention_days: 14

drupal_admin: admin
drupal_admin_password: CHANGEME   # SECRET

# Address on the uid 1 account, and so where its password reset link goes.
# Defaults to drupal_email (the site's own "from" address). Set it only if the
# administrator's address should differ from the site's.
# drupal_admin_email: admin@example.com

# Drupal 12 will default this to FALSE. Setting it explicitly clears a status
# report warning and pins the behaviour across a major upgrade. Set true to keep
# browser-side HTML5 form validation enabled.
drupal_enable_html5_validation: false

# Password hashing. Drupal 12 will default to argon2id; this switches now.
# Must be an identifier from PHP's password_algos() -- "argon2id", not
# "PASSWORD_ARGON2ID". An unrecognised value silently falls back to bcrypt.
# Existing bcrypt hashes keep working and are rehashed on next login.
# Set to "" to leave PHP's default (bcrypt) in place.
drupal_password_algorithm: argon2id
drupal_password_options: {}

# Host header protection. Leave as an empty list to disable. When set, requests
# whose Host header matches none of these regular expressions are rejected, so
# an incorrect value makes the site unreachable -- set it once the hostname is
# settled.
drupal_trusted_host_patterns: []
# drupal_trusted_host_patterns:
#   - '^mysite\.example\.com$'


#
# Drupal modules
#

drupal_install_modules:
  - token
  - schema_metatag
  - ctools
  - pathauto
  - metatag

drupal_enable_modules:
  - token
  - schema_metatag
  - ctools
  - pathauto
  - metatag
